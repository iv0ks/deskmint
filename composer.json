{
    "name": "iv0ks/deskmint",
    "description": "Deskmint — Intentionally vulnerable path traversal lab (PHP helpdesk)",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.3"
    },
    "autoload": {
        "psr-4": {
            "Deskmint\\": "src/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "php-cs-fixer fix --dry-run --diff",
        "stan": "phpstan analyse"
    },
    "config": {
        "sort-packages": true
    }
}
